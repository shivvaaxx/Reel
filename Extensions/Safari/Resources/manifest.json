{
    "manifest_version": 3,
    "name": "Download with Reel",
    "description": "Send the page you're on, or any link, to Reel with one click.",
    "version": "1.1.0",
    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png"
    },
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "action": {
        "default_title": "Download with Reel",
        "default_icon": {
            "16": "images/toolbar-16.png",
            "19": "images/toolbar-19.png",
            "32": "images/toolbar-32.png",
            "38": "images/toolbar-38.png"
        }
    },
    "permissions": ["activeTab", "contextMenus", "nativeMessaging"]
}
